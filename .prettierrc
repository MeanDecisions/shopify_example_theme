{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "overrides": [
    {
      "files": "*.liquid",
      "options": {
        "plugins": ["@shopify/prettier-plugin-liquid"],
        "parser": "liquid-html",
        "singleQuote": false,
        "liquidSingleQuote": false,
        "printWidth": 110,
        "bracketSameLine": true,
        "singleAttributePerLine": false
      }
    }
  ]
}
